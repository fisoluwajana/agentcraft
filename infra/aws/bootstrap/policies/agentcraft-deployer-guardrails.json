{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEverythingOutsideLondon",
      "Effect": "Deny",
      "NotAction": [
        "iam:*", "sts:*", "budgets:*", "ce:*", "cur:*", "pricing:*", "freetier:*", "billing:*",
        "support:*", "health:*", "account:Get*", "s3:ListAllMyBuckets",
        "bedrock:*", "bedrock-mantle:*"
      ],
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["eu-west-2"]}}
    },
    {
      "Sid": "DenyNonGravitonOrOversizedInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {"StringNotLike": {"ec2:InstanceType": ["t4g.*", "*g.medium", "*g.large", "*g.xlarge"]}}
    },
    {
      "Sid": "DenyNonGravitonOrOversizedInAutoScaling",
      "Effect": "Deny",
      "Action": ["autoscaling:CreateAutoScalingGroup", "autoscaling:UpdateAutoScalingGroup"],
      "Resource": "*",
      "Condition": {"ForAnyValue:StringNotLike": {"autoscaling:InstanceTypes": ["t4g.*", "*g.medium", "*g.large", "*g.xlarge"]}}
    },
    {
      "Sid": "DenyCostlyOrOutOfScopeActions",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateNatGateway", "ec2:PurchaseReservedInstancesOffering", "ec2:PurchaseHostReservation",
        "ec2:PurchaseScheduledInstances", "ec2:PurchaseCapacityBlock", "ec2:AllocateHosts",
        "ec2:CreateCapacityReservation", "ec2:CreateTransitGateway", "ec2:CreateVpnGateway",
        "ec2:CreateClientVpnEndpoint", "ec2:CreateVpcPeeringConnection",
        "ec2:AuthorizeSecurityGroupIngress", "ec2:ModifySecurityGroupRules", "ec2-instance-connect:*",
        "savingsplans:*", "aws-marketplace:Subscribe",
        "bedrock:CreateProvisionedModelThroughput", "bedrock:UpdateProvisionedModelThroughput",
        "bedrock:CreateModelCustomizationJob", "bedrock:CreateModelImportJob", "bedrock:CreateMarketplaceModelEndpoint",
        "lambda:PutProvisionedConcurrencyConfig",
        "organizations:*", "account:Put*", "account:Delete*", "account:Enable*", "account:Disable*", "account:Close*",
        "freetier:UpgradeAccountPlan",
        "s3:PutAccountPublicAccessBlock", "s3:PutBucketAcl", "s3:PutObjectAcl",
        "iam:CreateUser", "iam:DeleteUser", "iam:CreateAccessKey", "iam:UpdateAccessKey",
        "iam:CreateLoginProfile", "iam:UpdateLoginProfile",
        "iam:AttachUserPolicy", "iam:PutUserPolicy", "iam:DetachUserPolicy", "iam:DeleteUserPolicy",
        "iam:PutUserPermissionsBoundary", "iam:DeleteUserPermissionsBoundary",
        "iam:AddUserToGroup", "iam:CreateGroup", "iam:DeleteRolePermissionsBoundary",
        "iam:CreateOpenIDConnectProvider", "iam:CreateSAMLProvider",
        "iam:UpdateAccountPasswordPolicy", "iam:CreateVirtualMFADevice"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyMarketplaceBilledModelsCreditsDoNotCover",
      "Effect": "Deny",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream", "bedrock:CreateModelInvocationJob"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/anthropic.*",
        "arn:aws:bedrock:*::foundation-model/cohere.*",
        "arn:aws:bedrock:*::foundation-model/twelvelabs.*",
        "arn:aws:bedrock:*::foundation-model/openai.gpt-6*",
        "arn:aws:bedrock:*:*:inference-profile/*anthropic.*",
        "arn:aws:bedrock:*:*:inference-profile/*cohere.*",
        "arn:aws:bedrock:*:*:inference-profile/*twelvelabs.*",
        "arn:aws:bedrock:*:*:inference-profile/*openai.gpt-6*"
      ]
    },
    {
      "Sid": "ProtectBootstrapIdentityAndBoundary",
      "Effect": "Deny",
      "NotAction": ["iam:Get*", "iam:List*"],
      "Resource": [
        "arn:aws:iam::__ACCOUNT_ID__:user/agentcraft-deployer",
        "arn:aws:iam::__ACCOUNT_ID__:policy/agentcraft-deployer*",
        "arn:aws:iam::__ACCOUNT_ID__:policy/agentcraft-boundary"
      ]
    }
  ]
}
